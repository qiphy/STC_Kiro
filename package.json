{
  "name": "stc-kiro",
  "version": "1.0.0",
  "private": true,
  "description": "Bank Cyber Recovery Platform: hackathon MVP for recovering a bank from a cyberattack",
  "type": "module",
  "main": "api/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,client -c blue,green \"npm:dev:api\" \"npm:dev:client\"",
    "dev:api": "node --watch api/index.js",
    "dev:client": "vite client",
    "build": "vite build client",
    "check:secrets": "node scripts/checkSecrets.js",
    "preview": "vite preview client",
    "test": "node --test \"api/**/*.test.js\"",
    "check:db": "node scripts/check-db.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "fast-check": "^4.10.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
