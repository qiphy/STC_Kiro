# Copy to .env and fill in. Never commit .env
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_API_BASE_URL=/api

# Optional: enables LLM-written advisories. Leave empty to use templates.
LLM_API_KEY=

# Optional: Gemini model name override (code has a default).
GEMINI_MODEL=

# Optional: allowed CORS origin when the client is served from another origin (default http://localhost:5173).
CLIENT_ORIGIN=

# Optional: local API port (default 3001). Ignored on Vercel.
PORT=